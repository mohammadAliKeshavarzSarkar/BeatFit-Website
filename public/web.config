<?xml version="1.0" encoding="utf-8"?>
<!--
  BeatFit SPA — IIS site for beatfit.ir (87.107.166.140)
  Required module: URL Rewrite (https://www.iis.net/downloads/microsoft/url-rewrite)

  Canonical origin: https://beatfit.ir
  Keep "HTTPS Redirect" DISABLED here. Live host already redirects HTTP→HTTPS
  outside this rule; enabling it caused a 301 loop on HTTPS requests (IIS {HTTPS}
  can read as off behind the current TLS binding/proxy).

  Permanent redirects MUST use absolute https://beatfit.ir/... targets. Relative
  Location URLs are absolutized as http:// when IIS sees the request as HTTP
  behind the current TLS offload (observed 2026-11-21 on /blog/heart-rate-zones).
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <rewrite>
      <rules>
        <rule name="HTTPS Redirect" stopProcessing="true" enabled="false">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Enable when non-apex hosts should consolidate to beatfit.ir. -->
        <rule name="Canonical Host" stopProcessing="true" enabled="false">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_HOST}" pattern="^beatfit\.ir$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://beatfit.ir/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>

        <!-- Previous ASCII training-load URL -> topical canonical in one HTTPS 301. -->
        <rule name="Legacy ASCII training-load path" stopProcessing="true">
          <match url="^blog/live-tv-group-training/?$" />
          <action type="Redirect" url="https://beatfit.ir/blog/training-load" redirectType="Permanent" appendQueryString="true" />
        </rule>

        <rule name="Strip trailing slash" stopProcessing="true">
          <match url="^(.+)/$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Redirect" url="https://beatfit.ir/{R:1}" redirectType="Permanent" />
        </rule>

        <rule name="Blog index to resources" stopProcessing="true">
          <match url="^blog$" />
          <action type="Redirect" url="https://beatfit.ir/resources" redirectType="Permanent" />
        </rule>

        <!-- Legacy Persian blog paths → ASCII public slugs (copy/paste-safe). -->
        <rule name="Legacy زون-های-ضربان-قلب" stopProcessing="true">
          <match url="^blog/%D8%B2%D9%88%D9%86-%D9%87%D8%A7%DB%8C-%D8%B6%D8%B1%D8%A8%D8%A7%D9%86-%D9%82%D9%84%D8%A8$" />
          <action type="Redirect" url="https://beatfit.ir/blog/heart-rate-zones" redirectType="Permanent" />
        </rule>
        <rule name="Legacy کنترل-شدت-تمرین-در-کلاس-گروهی" stopProcessing="true">
          <match url="^blog/%DA%A9%D9%86%D8%AA%D8%B1%D9%84-%D8%B4%D8%AF%D8%AA-%D8%AA%D9%85%D8%B1%DB%8C%D9%86-%D8%AF%D8%B1-%DA%A9%D9%84%D8%A7%D8%B3-%DA%AF%D8%B1%D9%88%D9%87%DB%8C$" />
          <action type="Redirect" url="https://beatfit.ir/blog/live-class-monitoring" redirectType="Permanent" />
        </rule>
        <rule name="Legacy پایش-ضربان-قلب-در-باشگاه" stopProcessing="true">
          <match url="^blog/%D9%BE%D8%A7%DB%8C%D8%B4-%D8%B6%D8%B1%D8%A8%D8%A7%D9%86-%D9%82%D9%84%D8%A8-%D8%AF%D8%B1-%D8%A8%D8%A7%D8%B4%DA%AF%D8%A7%D9%87$" />
          <action type="Redirect" url="https://beatfit.ir/blog/connected-training-system" redirectType="Permanent" />
        </rule>
        <rule name="Legacy تاریخچه-تمرین" stopProcessing="true">
          <match url="^blog/%D8%AA%D8%A7%D8%B1%DB%8C%D8%AE%DA%86%D9%87-%D8%AA%D9%85%D8%B1%DB%8C%D9%86$" />
          <action type="Redirect" url="https://beatfit.ir/blog/workout-history-progress" redirectType="Permanent" />
        </rule>
        <rule name="Legacy بار-تمرینی-چیست" stopProcessing="true">
          <match url="^blog/%D8%A8%D8%A7%D8%B1-%D8%AA%D9%85%D8%B1%DB%8C%D9%86%DB%8C-%DA%86%DB%8C%D8%B3%D8%AA$" />
          <action type="Redirect" url="https://beatfit.ir/blog/training-load" redirectType="Permanent" />
        </rule>
        <rule name="Legacy مقایسه-سنسور-ضربان-قلب" stopProcessing="true">
          <match url="^blog/%D9%85%D9%82%D8%A7%DB%8C%D8%B3%D9%87-%D8%B3%D9%86%D8%B3%D9%88%D8%B1-%D8%B6%D8%B1%D8%A8%D8%A7%D9%86-%D9%82%D9%84%D8%A8$" />
          <action type="Redirect" url="https://beatfit.ir/blog/heart-rate-sensor-comparison" redirectType="Permanent" />
        </rule>
        <rule name="Legacy طراحی-تمرین-گروهی" stopProcessing="true">
          <match url="^blog/%D8%B7%D8%B1%D8%A7%D8%AD%DB%8C-%D8%AA%D9%85%D8%B1%DB%8C%D9%86-%DA%AF%D8%B1%D9%88%D9%87%DB%8C$" />
          <action type="Redirect" url="https://beatfit.ir/blog/group-class-design" redirectType="Permanent" />
        </rule>

        <!-- React routes with their own HTML shell. Keys are filled at build time. -->
        <rule name="Indexable route HTML" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{BeatfitRoutes:{R:0}}" pattern="(.+)" />
          </conditions>
          <action type="Rewrite" url="{C:1}" appendQueryString="true" />
        </rule>

        <!-- Unknown URLs must be real 404s, not a homepage rewrite. -->
        <rule name="Real 404" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
      </rules>
      <rewriteMaps>
        <rewriteMap name="BeatfitRoutes">
          <!-- bf:routes -->
          <add key="gym" value="/route-html/gym.html" />
          <add key="coach" value="/route-html/coach.html" />
          <add key="athlete" value="/route-html/athlete.html" />
          <add key="resources" value="/route-html/resources.html" />
          <add key="demo" value="/route-html/demo.html" />
          <add key="blog/connected-training-system" value="/route-html/blog/connected-training-system.html" />
          <add key="blog/group-class-design" value="/route-html/blog/group-class-design.html" />
          <add key="blog/heart-rate-sensor-comparison" value="/route-html/blog/heart-rate-sensor-comparison.html" />
          <add key="blog/training-load" value="/route-html/blog/training-load.html" />
          <add key="blog/workout-history-progress" value="/route-html/blog/workout-history-progress.html" />
          <add key="blog/heart-rate-zones" value="/route-html/blog/heart-rate-zones.html" />
          <add key="blog/live-class-monitoring" value="/route-html/blog/live-class-monitoring.html" />
    <!-- /bf:routes -->
        </rewriteMap>
      </rewriteMaps>
    </rewrite>

    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <remove fileExtension=".webm" />
      <mimeMap fileExtension=".webm" mimeType="video/webm" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <remove name="Permissions-Policy" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=()" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
        <hiddenSegments>
          <add segment="node_modules" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="404.html" responseMode="File" />
    </httpErrors>
  </system.webServer>

  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <remove name="Cache-Control" />
          <add name="Cache-Control" value="no-store, no-cache, must-revalidate" />
          <remove name="Pragma" />
          <add name="Pragma" value="no-cache" />
          <remove name="Expires" />
          <add name="Expires" value="0" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <location path="404.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <remove name="Cache-Control" />
          <add name="Cache-Control" value="no-store, no-cache, must-revalidate" />
          <remove name="Pragma" />
          <add name="Pragma" value="no-cache" />
          <remove name="Expires" />
          <add name="Expires" value="0" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <location path="route-html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <remove name="Cache-Control" />
          <add name="Cache-Control" value="no-store, no-cache, must-revalidate" />
          <remove name="Pragma" />
          <add name="Pragma" value="no-cache" />
          <remove name="Expires" />
          <add name="Expires" value="0" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
